{
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@brainfactory/shared": "0.1.0",
    "@prisma/engines": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "main": "./dist/prisma-client.js",
  "name": "@brainfactory/db",
  "prisma": {
    "seed": "tsx seed.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "types": "./dist/prisma-client.d.ts",
  "version": "0.1.0"
}
